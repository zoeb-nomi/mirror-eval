# Copy to .env and fill in whatever you have. The harness runs on any subset and
# reports the rest as skipped. Nothing here ever leaves your machine.

ANTHROPIC_API_KEY=sk-ant-...     # console.anthropic.com/settings/keys
GEMINI_API_KEY=AQ....            # aistudio.google.com/apikey  (free tier, no card)
OPENAI_API_KEY=sk-...            # platform.openai.com/api-keys   ($5 minimum credit)
PERPLEXITY_API_KEY=pplx-...      # perplexity.ai/settings/api     (Pro includes $5/mo)

# Model overrides — set these if a provider renames something and preflight fails.
# ME_MODEL_ANTHROPIC=claude-sonnet-5
# ME_MODEL_GEMINI=gemini-flash-latest
# ME_MODEL_OPENAI=gpt-5.6-terra
# ME_MODEL_PERPLEXITY=sonar-pro

# Judge models (cheap tiers are correct here — the reasoning lives in the rubric)
# ME_JUDGE_ANTHROPIC=claude-haiku-4-5
# ME_JUDGE_GEMINI=gemini-flash-latest
