# Copy to .env (make setup does this) and fill in whatever you have. run.py reads keys from here via
# a tiny built-in loader (see run.py:_load_dotenv) — nothing here ever leaves
# your machine, and keys are never printed or logged.

ANTHROPIC_API_KEY=sk-ant-...     # console.anthropic.com/settings/keys
OPENAI_API_KEY=sk-...            # platform.openai.com/api-keys

# Model overrides — set these if a provider renames something.
# ME2_MODEL_ANTHROPIC=claude-sonnet-5
# ME2_MODEL_OPENAI=gpt-5.6-terra
